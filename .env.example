# Public origin of this server (no trailing slash). Required for Grok / iOS.
PUBLIC_URL=https://pcloud-mcp.example.com

# oauth | bearer | none
AUTH_MODE=oauth

# Password shown when Grok/Grokbot connect (oauth mode).
# If unset, a random password is written to data/connector-password.txt
CONNECTOR_PASSWORD=

# Required when AUTH_MODE=bearer
MCP_AUTH_TOKEN=

# pCloud. EU accounts: eapi.pcloud.com   US accounts: api.pcloud.com
PCLOUD_API_HOST=eapi.pcloud.com
PCLOUD_ACCESS_TOKEN=

# Optional: enable the Connect with pCloud button on /setup
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=

# shared: one pCloud account (connected at /setup) for everyone who knows
#         CONNECTOR_PASSWORD.
# per-user: everyone signs in with their own pCloud account when they add the
#         connector; needs AUTH_MODE=oauth and the client id/secret above.
PCLOUD_LOGIN=shared

PORT=3847
DATA_DIR=./data

# Optional: keep state (pCloud token, OAuth sessions) in Supabase instead of
# DATA_DIR files. Needed on serverless hosts such as Vercel. Use the secret
# (service role) key — the table has RLS on and no public policies.
SUPABASE_URL=
SUPABASE_KEY=
# Optional: encrypts stored state (AES-256-GCM). Keep it stable once set.
KV_SECRET=
